# ==============================================================================
# TicketNotify Configuration Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Credentials
# ------------------------------------------------------------------------------
# Telegram Bot Token obtained from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Telegram numerical User ID of the bot administrator (receives startup alerts and health pings)
ADMIN_ID=1483331491

# Optional TMDB (The Movie Database) API v3 key for upcoming movie discovery and countdowns
# Get free API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ------------------------------------------------------------------------------
# 2. Database & Cache
# ------------------------------------------------------------------------------
# SQLAlchemy async connection URL:
#   - Local development: sqlite+aiosqlite:///./ticketnotify.db
#   - Production (Render PostgreSQL): postgresql+asyncpg://user:pass@host:5432/dbname
# Note: Render provides DATABASE_URL starting with postgres:// which is auto-normalized by TicketNotify.
DATABASE_URL=sqlite+aiosqlite:///./ticketnotify.db

# Redis connection URL for caching live theatre discovery and screen layouts
# Render Redis: redis://red-xxxx:6379 | Local: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Fallback to in-memory async Redis (fakeredis) if real Redis is unavailable or down
USE_IN_MEMORY_REDIS_FALLBACK=true

# ------------------------------------------------------------------------------
# 3. Webhook vs Long-Polling Mode
# ------------------------------------------------------------------------------
# Set WEBHOOK_MODE=true for production Web Service on Render with HTTPS
# Set WEBHOOK_MODE=false for local development or background worker long polling
WEBHOOK_MODE=false

# Public base URL of your Render Web Service (required if WEBHOOK_MODE=true)
# Example: https://ticketnotify.onrender.com
WEBHOOK_URL=

# Webhook endpoint path (default: /webhook)
WEBHOOK_PATH=/webhook

# Telegram webhook secret token to prevent unauthorized requests (validated via header)
WEBHOOK_SECRET=ticketnotify_secure_random_token_here

# ------------------------------------------------------------------------------
# 4. HTTP Server Settings
# ------------------------------------------------------------------------------
# Host to bind the FastAPI server (0.0.0.0 in Docker/Render)
HOST=0.0.0.0

# Port to listen on (Render dynamically sets $PORT environment variable)
PORT=8000

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 5. Polling Engine & Circuit Breakers
# ------------------------------------------------------------------------------
# Polling interval in seconds for imminent or hot movies (within 48h or high demand)
# (Automatically capped to >= 5.0s on direct-IP to prevent IP bans)
HOT_POLL_INTERVAL=20

# Polling interval in seconds for far/idle releases
IDLE_POLL_INTERVAL=150

# HTTP request timeout in seconds for platform booking adapters (BMS, PVR, District, TicketNew)
SCRAPER_REQUEST_TIMEOUT=10.0

# Number of consecutive HTTP failures before tripping platform circuit breaker to OPEN
CIRCUIT_BREAKER_MAX_FAILURES=5

# Seconds to pause monitoring on a tripped platform before attempting a probe (half-open)
CIRCUIT_BREAKER_RESET_TIMEOUT=120

# ------------------------------------------------------------------------------
# 6. Telegram Outbound Rate Limiting
# ------------------------------------------------------------------------------
# Global outbound Telegram messages allowed per second
GLOBAL_RATE_LIMIT_PER_SEC=30

# Per-chat outbound Telegram messages allowed per second (Telegram restricts to 1/sec)
CHAT_RATE_LIMIT_PER_SEC=1.0

# ------------------------------------------------------------------------------
# 7. Proxies & IP Rotation
# ------------------------------------------------------------------------------
# Comma-separated list of HTTP or SOCKS5 residential/datacenter proxies
# Format: http://user:pass@prx1.example.com:8080,http://user:pass@prx2.example.com:8080
# Leave empty for direct-IP mode (which enforces a safe 5.0s minimum poll cap)
PROXY_LIST=

# Rotate user agents across browser signatures
USER_AGENT_ROTATION=true

# ------------------------------------------------------------------------------
# 8. Observability & Monitoring
# ------------------------------------------------------------------------------
# Enable Prometheus metrics endpoint at /metrics
PROMETHEUS_METRICS_ENABLED=true

# Optional Sentry DSN for exception tracking
SENTRY_DSN=

# Testing flag (used by pytest to skip background network loops)
TESTING=false
