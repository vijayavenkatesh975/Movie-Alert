# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=123456789

# Database & Cache
# For production (PostgreSQL): postgresql+asyncpg://ticketuser:ticketpass@postgres:5432/ticketnotify
# For local development: sqlite+aiosqlite:///./ticketnotify.db
DATABASE_URL=sqlite+aiosqlite:///./ticketnotify.db
REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_REDIS_FALLBACK=true

# Webhook Configuration (Set WEBHOOK_MODE=true for production deployment with HTTPS)
WEBHOOK_MODE=false
WEBHOOK_URL=https://your-domain.onrender.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=your_random_webhook_secret_here

# Server Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Polling & Scraper Settings
HOT_POLL_INTERVAL=20
IDLE_POLL_INTERVAL=150
SCRAPER_REQUEST_TIMEOUT=10.0
CIRCUIT_BREAKER_MAX_FAILURES=5
CIRCUIT_BREAKER_RESET_TIMEOUT=120

# Telegram Outbound Rate Limiting
GLOBAL_RATE_LIMIT_PER_SEC=30
CHAT_RATE_LIMIT_PER_SEC=1.0

# Proxies (Comma separated HTTP or SOCKS5 proxies)
# PROXY_LIST=http://user:pass@proxy1.com:8080,http://user:pass@proxy2.com:8080
PROXY_LIST=

# Optional Sentry Monitoring
SENTRY_DSN=
